# ==============================================================================
# Database Configuration (PostgreSQL / AWS RDS)
# ==============================================================================
POSTGRES_DB=loan_eligibility
POSTGRES_USER=loan_app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5433

# Application DB Connection (Used by Lambdas and Local Ingestion)
# For local Docker: localhost:5433
# For deployed AWS Lambda: your-rds-endpoint.amazonaws.com:5432
DB_HOST=localhost
DB_PORT=5433
DB_NAME=loan_eligibility
DB_USER=loan_app
DB_PASSWORD=replace_with_strong_password

# ==============================================================================
# n8n Automation Engine Settings
# ==============================================================================
N8N_DB_NAME=n8n
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Ingestion Lambda -> n8n Webhook Authentication
# For local testing via host: http://localhost:5678/webhook/loan_match
# For deployed AWS Lambda: https://your-public-n8n.domain.com/webhook/loan_match
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loan_match
WEBHOOK_SECRET=replace_with_a_secure_shared_webhook_secret

# ==============================================================================
# Notification Settings (Workflow C & AWS SES)
# ==============================================================================
# When TEST_MODE is true, emails are rewritten to GMAILUSER+userid@gmail.com
TEST_MODE=true
GMAILUSER=your.gmail.username
SES_FROM_EMAIL=verified-sender@example.com
AWS_REGION=ap-south-1

# Optional: AWS Credentials for local testing / n8n SES node
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==============================================================================
# AI / LLM Configuration (Workflow A Crawler Fallback)
# ==============================================================================
# Gemini Free Tier API Key (only called if regex extraction fails)
GEMINI_API_KEY=your_google_gemini_api_key
